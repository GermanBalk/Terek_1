import tkinter as tk
from tkinter import messagebox, simpledialog
import json
import os
import random

# Файл для хранения истории
FILENAME = 'tasks.json'

# Предопределённые задачи с типами
default_tasks = [
    {"task": "Прочитать статью", "type": "учёба"},
    {"task": "Сделать зарядку", "type": "спорт"},
    {"task": "Ответить на письма", "type": "работа"},
    {"task": "Выучить новую тему", "type": "учёба"},
    {"task": "Пробежка на улице", "type": "спорт"},
    {"task": "Обновить резюме", "type": "работа"},
]

# Загрузка истории
def load_history():
    if os.path.exists(FILENAME):
        with open(FILENAME, 'r', encoding='utf-8') as f:
            return json.load(f)
    return []

# Сохранение истории
def save_history():
    with open(FILENAME, 'w', encoding='utf-8') as f:
        json.dump(history, f, ensure_ascii=False, indent=4)

# Обновление списка задач
def update_listbox(filtered_tasks=None):
    listbox.delete(0, tk.END)
    data = filtered_tasks if filtered_tasks is not None else history
    for item in data:
        display_text = f"{item['task']} [{item['type']}]"
        listbox.insert(tk.END, display_text)

# Генерация случайной задачи
def generate_task():
    # выбираем случайную задачу из предопределённых
    task = random.choice(default_tasks)
    # добавляем в историю
    history.append(task)
    save_history()
    update_listbox()

# Фильтрация по типу
def filter_tasks():
    selected_type = filter_var.get()
    if selected_type == 'Все':
        update_listbox()
    else:
        filtered = [t for t in history if t['type'] == selected_type]
        update_listbox(filtered)

# Добавление пользовательской задачи
def add_task():
    task_text = simpledialog.askstring("Добавить задачу", "Введите описание задачи:")
    if task_text and task_text.strip():
        task_type = simpledialog.askstring("Тип задачи", "Введите тип задачи (учёба, спорт, работа):")
        if task_type in ['учёба', 'спорт', 'работа']:
            new_task = {"task": task_text.strip(), "type": task_type}
            history.append(new_task)
            save_history()
            update_listbox()
        else:
            messagebox.showerror("Ошибка", "Некорректный тип задачи.")
    else:
        messagebox.showwarning("Предупреждение", "Пустая строка недопустима!")

# Инициализация окна
root = tk.Tk()
root.title("Random Task Generator")

# Кнопка генерации
btn_generate = tk.Button(root, text="Сгенерировать задачу", command=generate_task, width=20)
btn_generate.pack(pady=10)

# Фильтр по типу
filter_var = tk.StringVar(value='Все')
frame_filter = tk.Frame(root)
frame_filter.pack(pady=5)

tk.Radiobutton(frame_filter, text='Все', variable=filter_var, value='Все', command=filter_tasks).pack(side='left')
tk.Radiobutton(frame_filter, text='учёба', variable=filter_var, value='учёба', command=filter_tasks).pack(side='left')
tk.Radiobutton(frame_filter, text='спорт', variable=filter_var, value='спорт', command=filter_tasks).pack(side='left')
tk.Radiobutton(frame_filter, text='работа', variable=filter_var, value='работа', command=filter_tasks).pack(side='left')

# Область для списка
listbox = tk.Listbox(root, width=50, height=15, font=("Arial", 12))
listbox.pack(padx=10, pady=10)

# Кнопки управления
btn_add = tk.Button(root, text="Добавить свою задачу", command=add_task)
btn_add.pack(pady=5)

# Загрузка истории при запуске
history = load_history()
update_listbox()

root.mainloop()
